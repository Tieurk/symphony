      "Bash(od *)", "Bash(base64 *)", "Bash(echo *)", "Bash(printf *)", "Bash(test *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(chmod *)", "Bash(tar *)",
